# ------------------------------------------------------------------
# MOONUKE environment. Copy to .env.local (never commit real values).
# Every variable here is SERVER-ONLY. Nothing is prefixed NEXT_PUBLIC_.
# ------------------------------------------------------------------

# Postgres connection (Supabase: use the pooled connection string).
DATABASE_URL=postgresql://postgres@localhost:54329/moonuke

# 32+ random characters. Signs media URLs and keys IP hashes.
# Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
MOONUKE_SECRET=

# Public base URL, used when printing invitation links from scripts.
APP_URL=http://localhost:3000

# One-time owner bootstrap (pnpm owner:create). Remove after use.
OWNER_EMAIL=
OWNER_ALIAS=The House
OWNER_PASSWORD=
