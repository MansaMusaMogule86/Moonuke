# ------------------------------------------------------------------
# Environment template. Copy to .env.local for development, or set these
# in your host's secret manager for production. NEVER commit real values.
# Every variable is SERVER-ONLY; nothing uses the NEXT_PUBLIC_ prefix.
# Validate with:  NODE_ENV=production pnpm env:check
# ------------------------------------------------------------------

# Postgres (Supabase: the pooled connection string, role with schema owner rights).
DATABASE_URL=postgresql://postgres@localhost:54329/moonuke

# 32+ random characters. Signs media URLs, keys IP/rate-limit hashes,
# and derives the MFA secret encryption key. Rotating it invalidates
# signed URLs and enrolled authenticators (owners must re-enrol).
# Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=

# Public origin. Must be https:// in production.
APP_URL=http://localhost:3000

# Which proxy sets the client IP header. Required explicitly in production.
#   none        no trusted proxy (IP-based rate limits are skipped)
#   vercel      Vercel edge (x-real-ip)
#   cloudflare  Cloudflare (cf-connecting-ip)
#   hops:N      N load balancers that each append to X-Forwarded-For
TRUSTED_PROXY=none

# Email delivery.
#   dev       store messages in the local dev mailbox table (NOT allowed in production)
#   smtp      send via SMTP_URL (any provider — none is pre-selected or purchased)
#   disabled  send nothing; owner delivers invitation links manually
EMAIL_TRANSPORT=dev
# SMTP_URL=smtps://user:password@smtp.example.com:465
# EMAIL_FROM="Moonuke <no-reply@example.com>"

# AI-assisted profile drafting.
#   template   (default) local generator — free, nothing leaves the server
#   anthropic  Claude via the API — opt-in; usage is billed to your Anthropic account
#   disabled   hide the assistant
AI_PROVIDER=template
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5

# Local QA only: lets a production build run on http://localhost with dev email.
# Refused for any non-localhost APP_URL. Never set in a real deployment.
# ALLOW_LOCAL_PRODUCTION=true

# One-time owner bootstrap (pnpm owner:create). Remove after use.
OWNER_EMAIL=
OWNER_ALIAS=The House
OWNER_PASSWORD=
