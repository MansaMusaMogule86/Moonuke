{
  "name": "moonuke",
  "version": "0.1.0",
  "private": true,
  "description": "MOONUKE — a private creator club. Black & gold.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "screens": "node scripts/screenshots.mjs",
    "smoke": "node scripts/e2e-smoke.mjs",
    "db:migrate": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:seed": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/seed.ts",
    "owner:create": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/create-owner.ts",
    "test:server": "vitest run --project server",
    "env:check": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/env-check.ts",
    "email:drain": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/email-drain.ts",
    "blasts:run": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/blasts-run.ts",
    "maintenance": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/maintenance.ts",
    "verify": "node scripts/verify.mjs",
    "verify:quick": "node scripts/verify.mjs --quick"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "clsx": "^2.1.1",
    "motion": "^14.9.1",
    "next": "^16.4.5",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "playwright": "1.63.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
